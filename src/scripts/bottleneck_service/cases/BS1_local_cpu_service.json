{
  "analysis": {
    "monitored_services": [
      "gateway",
      "svc-cpu"
    ],
    "root_service": "gateway"
  },
  "base_url": "http://172.31.32.23:80",
  "case_name": "BS1_local_cpu_service",
  "collector_duration_seconds": 90,
  "controller_deployment": "custom-autoscaler",
  "duration_seconds": 90,
  "expected": {
    "bottleneck_service": "svc-cpu",
    "graph_edges": [
      "gateway->svc-cpu"
    ],
    "leaf_reason_class": "local_cpu_pressure",
    "path_reason_class": "downstream_delay",
    "reason_class": "local_cpu_pressure"
  },
  "initial_replicas": {
    "gateway": 1,
    "svc-chain": 1,
    "svc-cpu": 1,
    "svc-fanout": 1,
    "svc-io": 1,
    "svc-mem": 1,
    "svc-net": 1
  },
  "interval_seconds": 5,
  "mode": "observation",
  "namespace": "thrive-demo",
  "phase_name": "bottleneck_service",
  "phases": [
    {
      "duration_seconds": 90,
      "name": "steady",
      "route_mix": {
        "cpu_hot": 1.0
      },
      "rps": 10.0
    }
  ],
  "random_seed": 7,
  "routes": {
    "cpu_hot": {
      "method": "GET",
      "path": "/cpu?count=80000000"
    }
  },
  "stabilization_seconds": 35,
  "system_namespace": "thrive-scale"
}
